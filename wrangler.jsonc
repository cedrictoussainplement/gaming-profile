// Un seul Worker : le site statique (out/), l'API /api/* et la synchro nocturne.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaming-profile",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Tous les jours à 4 h UTC.
  "triggers": { "crons": ["0 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gaming-profile",
      // À remplacer par l'id affiché par `npx wrangler d1 create gaming-profile` (pas secret).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": { "enabled": true }
}
